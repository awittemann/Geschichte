# Beispiel-Umgebungsvariablen für die Lernkarten-App.
# Zum lokalen Entwickeln: diese Datei nach `.env.local` kopieren und ausfüllen.
# In Produktion (Sliplane/Vercel) als Environment Variables des Services setzen.

# --- Nutzer-Accounts (Multi-User-Modus) -------------------------------------
# Signiert die Session-Cookies. Mindestens 16 Zeichen.
# In Produktion ZWINGEND — ohne diese Variable startet die App dort nicht.
# Erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=

# Optional: Pfad der Server-Datenbank (JSON-Datei).
# Default: Produktion /data/state.json, Entwicklung .local-state.json
# LERNKARTEN_DB_PATH=

# --- KI-Abfragemodus (OpenAI) -----------------------------------------------
# API-Key von https://platform.openai.com/api-keys
# Fehlt der Key, ist nur der KI-Abfragemodus deaktiviert — der Rest der App
# funktioniert normal weiter.
OPENAI_API_KEY=

# Optional: zu verwendendes Chat-Modell. Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
